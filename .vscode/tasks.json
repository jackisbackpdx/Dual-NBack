{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Serve",
      "detail": "Start the static server on http://localhost:8000",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "group": { "kind": "build", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "pattern": [{ "regexp": "^$", "file": 1, "location": 2, "message": 3 }],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*node tools/serve\\.js.*$",
          "endsPattern": "^Dual N-Back on http://localhost:\\d+$"
        }
      }
    },
    {
      "label": "Test",
      "detail": "Run the game-logic tests",
      "type": "shell",
      "command": "npm test",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    }
  ]
}
